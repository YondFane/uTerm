{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "uTerm",
  "version": "0.1.4",
  "identifier": "sh.uterm.desktop.dev",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "uTerm",
        "width": 1100,
        "height": 720,
        "minWidth": 640,
        "minHeight": 420,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false,
        "trafficLightPosition": {
          "x": 16,
          "y": 22
        },
        "backgroundColor": "#000000",
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'self' blob: about:",
      "capabilities": ["main"]
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["uterm"]
      }
    }
  }
}
