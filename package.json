{
  "name": "uterm",
  "version": "0.2.1",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "i18n:check": "node --experimental-strip-types scripts/i18n-check.mjs",
    "build": "pnpm check && vite build",
    "preview": "vite preview",
    "site:dev": "node scripts/site-preview.mjs",
    "site:check": "node --test tests/site.test.mjs",
    "tauri": "tauri",
    "uterm:dev": "tauri dev",
    "desktop:build": "node scripts/package.mjs",
    "desktop:check": "node node_modules/@tauri-apps/cli/tauri.js build --debug --no-bundle -- --locked",
    "test": "node --experimental-strip-types --test --test-concurrency=4 tests/*.test.mjs",
    "format": "prettier --write src tests scripts site \"*.{json,ts,html}\" \"src-tauri/{tauri.conf.json,capabilities/*.json}\" && cargo fmt --manifest-path src-tauri/Cargo.toml && cargo fmt --manifest-path crates/utermd-local/Cargo.toml",
    "format:check": "prettier --check src tests scripts site \"*.{json,ts,html}\" \"src-tauri/{tauri.conf.json,capabilities/*.json}\" && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo fmt --manifest-path crates/utermd-local/Cargo.toml -- --check",
    "test:host": "cargo test --manifest-path crates/utermd-local/Cargo.toml --locked",
    "database:build": "node scripts/database-component.mjs",
    "test:database": "pnpm database:build && node --experimental-strip-types --test tests/database-bridge.test.mjs",
    "test:redis": "cargo test --manifest-path src-tauri/Cargo.toml --locked redis::tests -- --include-ignored",
    "test:backend": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "docs:sync": "node scripts/docs-index.mjs",
    "docs:check": "node scripts/docs-index.mjs --check",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.15",
    "markdown-it": "^15.0.2",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@tauri-apps/cli": "^2.11.5",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "prettier": "3.9.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2
  }
}
